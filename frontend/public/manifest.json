{
  "manifest_version": 3,
  "name": "AutoDev",
  "description": "Ask questions about any Python repository on GitHub, right on its page.",
  "version": "1.0.0",
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "action": { "default_title": "AutoDev", "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png" } },
  "background": { "service_worker": "js/background.js" },
  "content_scripts": [{ "matches": ["https://github.com/*"], "js": ["js/content.js"] }],
  "host_permissions": ["http://127.0.0.1:3000/*"]
}
